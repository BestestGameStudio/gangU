[gd_scene load_steps=4 format=3 uid="uid://bgangu6hud"]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

; #93: HP bar readability - dark flat track + green fill (state color shifts
; to amber/red at low fractions are applied in hud.gd _on_health_changed).
[sub_resource type="StyleBoxFlat" id="HPTrack"]
bg_color = Color(0.08, 0.08, 0.1, 0.9)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="HPFill"]
bg_color = Color(0.35, 0.8, 0.4, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="BackingPlate" type="ColorRect" parent="."]
mouse_filter = 2
color = Color(0.02, 0.02, 0.03, 0.55)

[node name="Root" type="VBoxContainer" parent="."]
offset_left = 12.0
offset_top = 12.0
offset_right = 400.0
offset_bottom = 200.0
theme_override_constants/separation = 6

[node name="HPLabel" type="Label" parent="Root"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "HP --/--"

[node name="HPBar" type="ProgressBar" parent="Root"]
custom_minimum_size = Vector2(260, 22)
layout_mode = 2
theme_override_styles/background = SubResource("HPTrack")
theme_override_styles/fill = SubResource("HPFill")
show_percentage = false

[node name="ObjectiveLabel" type="Label" parent="Root"]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Objective: --"

[node name="SpellRows" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="SlotRows" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 4
