; Engine configuration file.
; gangU - 2D top-down arcade shooter (Brawlstars-like)
; Godot 4.5.1-stable, GDScript. See README.md for setup/run/export.

config_version=5

[application]

config/name="gangU"
config/description="2D top-down arcade shooter. Single-player first, co-op later. Spells only, no weapons."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

switch_spell={
"deadzone": 0.5,
"events": []
}

